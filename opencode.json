{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        {
            "action": "external_directory",
            "resource": "~/**",
            "effect": "deny"
        },
        {
            "action": "external_directory",
            "resource": "~/Work/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.config/**",
            "effect": "allow"
        }
    ],
    "mcp": {
        "servers": {
            "notion": {
                "disabled": false,
                "type": "remote",
                "url": "https://mcp.notion.com/mcp"
            },
            "jira": {
                "disabled": false,
                "type": "remote",
                "url": "https://mcp.atlassian.com/v2/mcp"
            },
            "coralogix": {
                "disabled": true,
                "type": "remote",
                "url": "https://api.eu2.coralogix.com/mgmt/api/v1/mcp"
            }
        }
    }
}
