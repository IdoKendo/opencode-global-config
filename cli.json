{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "plugins": [
    "-opencode.sidebar.mcp",
    "./plugins/quota-usage",
    "./plugins/goal-sidebar",
    "./plugins/skills-sidebar",
    "./plugins/notification",
    "./plugins/workmux-status",
    "./plugins/tmux-tabs",
    "./plugins/find-in-session"
  ],
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "mode": "off"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
