{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "plugins": [
    "-opencode.sidebar.mcp",
    "./plugins/quota-usage/tui.tsx",
    "./plugins/goal-sidebar/tui.tsx",
    "./plugins/skills-sidebar/tui.tsx",
    "./plugins/notification/tui.ts",
    "./plugins/workmux-status/tui.ts",
    "./plugins/tmux-tabs/tui.ts"
  ],
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "mode": "off"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
