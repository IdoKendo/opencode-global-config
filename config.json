{
    "$schema": "https://opencode.ai/config.json",
    "theme": "tokyonight",
    "mcp": {
        "notion": {
            "enabled": false,
            "type": "remote",
            "url": "https://mcp.notion.com/mcp"
        },
        "jira": {
            "enabled": false,
            "type": "remote",
            "url": "https://mcp.atlassian.com/v1/sse"
        },
        "gitlab": {
            "enabled": false,
            "type": "remote",
            "url": "https://gitlab.com/api/v4/mcp"
        },
        "coralogix": {
            "enabled": false,
            "type": "remote",
            "url": "https://api.eu2.coralogix.com/mgmt/api/v1/mcp"
        },
        "grafana": {
            "enabled": false,
            "type": "local",
            "command": [
                "uvx",
                "mcp-grafana"
            ],
            "environment": {
                "GRAFANA_URL": "http://localhost:3000",
                "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
            }
        }
    }
}
